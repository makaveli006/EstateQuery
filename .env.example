# Copy to .env and fill in. .env is git-ignored.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Hostname Caddy requests a TLS certificate for (e.g. estatequery.duckdns.org)
SITE_HOST=localhost

# Chat history (Chainlit sidebar). Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
CHAINLIT_AUTH_SECRET=

# Login for the whole site (HTTP Basic Auth in Caddy). Only a hash of the password is stored.
# Generate it with:   caddy hash-password        (type the password; output starts with $2a$)
# Keep the hash in SINGLE quotes, because it contains $ characters:
#   BASIC_AUTH_HASH='$2a$14$...'
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
