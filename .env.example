# Copy to .env and fill in the values. .env is git-ignored; never commit real keys.

# --- Runtime ---------------------------------------------------------------
# dev | prod
APP_ENV=dev

# --- LLM provider switch ---------------------------------------------------
# anthropic | openrouter. One line switches the whole app; both adapters stay supported.
LLM_PROVIDER=anthropic

# Anthropic (development and testing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# OpenRouter (deployed app; must be a free model that supports tool calling)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Comma-separated backup models, tried in order when the primary is rate limited
OPENROUTER_FALLBACK_MODELS=

# --- Tracing (Langfuse Cloud) ----------------------------------------------
# Leave the keys empty to switch tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Limits and guardrails -------------------------------------------------
MAX_INPUT_CHARS=1000
MAX_TOOL_ROUNDS=4
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_CAP=800
RERANKER_ENABLED=false

# --- Paths -----------------------------------------------------------------
DATA_DIR=data

# --- Deployment scripts only (not read by the app) --------------------------
AWS_PROFILE=estatequery
AWS_REGION=eu-west-2
