# Secrets: never commit
.env
.env.*
!.env.example

# Scraped data and built indexes (rebuilt by the ingestion pipeline)
data/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Tools and editors
.playwright-mcp/
.chainlit/*
!.chainlit/config.toml
# The project's wording overrides; Chainlit regenerates the other languages itself.
!.chainlit/translations/
.chainlit/translations/*
!.chainlit/translations/en-US.json
.files/
.idea/
.vscode/
*.log

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# Deployment secrets (SSH key, host details)
deploy/.secrets/

# Terraform: generated SSH key and local variable values
infra/terraform/.secrets/

# Full evaluation transcripts quote listing data; only the summary is published
eval/results.json
